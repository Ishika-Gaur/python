import re

pattern = re.compile(r"[A-Za-z0-9!@#$%^&*]{8,}\d")

password = input("Enter Password : ")

if pattern.fullmatch(password):
    print("Valid Password")
else:
    print("Invalid Password")



#     \d kya represent karta hai?
# Any Digit (0-9)

